{
  "name": "dndmockup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "sharp": "^0.35.5"
  }
}
